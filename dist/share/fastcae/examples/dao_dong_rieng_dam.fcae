# Dao dong rieng dam cong xon thep IPE300 (L = 3 m): tan so dang 1 = 10.96 Hz (cong thuc: 1.8751^2/2pi * sqrt(EI/rho A L^4)), dang 2 la dang xoan.
# Dầm công xôn (mau khung/dan FastCAE, tac gia Tran Minh Tam)
# Dầm thép chữ I ngàm một đầu, lực tập trung ở đầu tự do.
type = frame
E = 210e9
nu = 0.3
rho = 7850
yield = 235e6   # gioi han chay thep CCT34 (Pa): tinh he so su dung
section = IPE ibeam 0.15 0.30 0.0107 0.0071   # chu I: b h tf tw (m)
node = 1 0 0 0
node = 2 0.25 0 0
node = 3 0.5 0 0
node = 4 0.75 0 0
node = 5 1 0 0
node = 6 1.25 0 0
node = 7 1.5 0 0
node = 8 1.75 0 0
node = 9 2 0 0
node = 10 2.25 0 0
node = 11 2.5 0 0
node = 12 2.75 0 0
node = 13 3 0 0
member = 1 2 IPE beam
member = 2 3 IPE beam
member = 3 4 IPE beam
member = 4 5 IPE beam
member = 5 6 IPE beam
member = 6 7 IPE beam
member = 7 8 IPE beam
member = 8 9 IPE beam
member = 9 10 IPE beam
member = 10 11 IPE beam
member = 11 12 IPE beam
member = 12 13 IPE beam
support = 1 fixed
nload = 13 0 0 -1000

analysis = modal
modes = 6
mode = 1       # dang hien thi (doi thanh 2, 3, ... roi bam Chay)
