# Dầm console như examples/cantilever.fcae nhưng giải bằng thuật toán FEM viết bằng Python (plugin my_fem).
# FastCAE chỉ dựng mô hình + hiển thị; phép giải nằm trong my_fem.py.
type = elastic
geometry = box 1.0 0.1 0.1
divisions = 20 3 3
order = 2
E = 210e9
nu = 0.3
fix = xmin
load = xmax 0 0 -1000
solver = my_fem
output = cantilever_myfem.vtk
