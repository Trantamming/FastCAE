# Gối đỡ tham số: tấm đế có 2 lỗ + gân trụ. Đơn vị: mét. Đổi tham số rồi giải lại là xong.
param L  = 0.20        # chiều dài đế
param W  = 0.08        # chiều rộng đế
param T  = 0.012       # chiều dày đế
param D  = 0.016       # đường kính lỗ
param E  = 0.025       # khoảng cách lỗ đến mép
param R  = D/2

sketch outline xy 0
  rect 0 0 L W
  circle E W/2 R
  circle L-E W/2 R
end
extrude base outline T

cylinder boss L/2 W/2 T 0 0 0.04 0.02
fuse part base boss
result part

# Bo tròn 4 góc đứng của đế (r = 8 mm): mỗi lệnh chọn các cạnh nằm trọn trong một hộp; áp dụng sau cùng
fillet 0.008  -0.001 -0.001 -0.001     0.001 0.001 T+0.001
fillet 0.008  L-0.001 -0.001 -0.001     L+0.001 0.001 T+0.001
fillet 0.008  -0.001 W-0.001 -0.001     0.001 W+0.001 T+0.001
fillet 0.008  L-0.001 W-0.001 -0.001     L+0.001 W+0.001 T+0.001
