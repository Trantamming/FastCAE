# Mẫu cho chi tiết CAD nhập từ STEP (cần bản build có Gmsh).
# Thay model.step bằng file xuất từ SolidWorks/Inventor/Fusion/Creo/CATIA/NX...
type = elastic
geometry = file model.step
unit_scale = 0.001        # STEP đơn vị mm -> mét
mesh_size = 0.005         # cỡ phần tử tối đa (m)
E = 200e9
nu = 0.3
fix = xmin
load = xmax 0 -500 0
output = step_model.vtk
