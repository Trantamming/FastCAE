execute_process(COMMAND ${CLI} result import ${IN} ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "import loi: ${out} ${err}")
endif()
foreach(needle "Da nap chuoi buoc: 3 khung")
  string(FIND "${out}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "thieu '${needle}' trong: ${out}")
  endif()
endforeach()
execute_process(COMMAND ${CLI} result info ${OUT} RESULT_VARIABLE rc2 OUTPUT_VARIABLE info)
if(NOT rc2 EQUAL 0)
  message(FATAL_ERROR "info loi (nap lai .fcres co khung that bai): ${info}")
endif()
string(FIND "${info}" "chuoi buoc: 3 khung (step_0001 ... step_0010)" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "chuoi khong dung thu tu/so khung: ${info}")
endif()
