# Sinh mẫu bồn trụ, chạy với ccx thật và kiểm tra kết quả hợp lệ.
execute_process(COMMAND ${CLI} template plate_simply_supported OUTPUT_VARIABLE CASE_TEXT RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "template failed")
endif()
string(REGEX REPLACE "output = [^\n]*" "" CASE_TEXT "${CASE_TEXT}")
file(WRITE ${WORK}/shell_case.fcae "${CASE_TEXT}\nwork_dir = ${WORK}/ccx_shell_test\n")
execute_process(COMMAND ${CLI} run ${WORK}/shell_case.fcae OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT out MATCHES "Hoi tu \\(CalculiX")
    message(FATAL_ERROR "ccx shell case did not converge:\n${out}")
endif()
# độ võng tâm phải trong 5% lời giải Kirchhoff 2.1112e-4 (lưới 24x24)
string(REGEX MATCH "u\\|max = ([0-9.e+-]+)" m "${out}")
set(w ${CMAKE_MATCH_1})
math(EXPR ok "0")
if(w LESS 2.2e-4 AND w GREATER 2.0e-4)
    set(ok 1)
endif()
if(NOT ok)
    message(FATAL_ERROR "plate deflection ${w} outside the expected range")
endif()
