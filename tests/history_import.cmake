execute_process(COMMAND ${CLI} result import ${IN} ${OUT} --history ${HIST} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "import loi: ${out} ${err}")
