# Dựng SU2_CFD và run_aster giả, kiểm tra fastcae-cli solver-run.
set(D ${WORK}/fake_solvers)
file(MAKE_DIRECTORY ${D})
file(WRITE ${D}/SU2_CFD "#!/bin/sh\necho su2 chay $1\necho r > history.csv\n")
file(WRITE ${D}/run_aster "#!/bin/sh\necho aster loi\nexit 3\n")
execute_process(COMMAND chmod +x ${D}/SU2_CFD ${D}/run_aster)
file(WRITE ${D}/a.cfg "SOLVER= EULER\n")
file(WRITE ${D}/m.export "x\n")
set(ENV{PATH} "${D}:$ENV{PATH}")
execute_process(COMMAND ${CLI} solver-run su2 ${D}/a.cfg RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "su2 chay" OR NOT out MATCHES "history.csv")
    message(FATAL_ERROR "su2 gia that bai (rc=${rc}):\n${out}")
endif()
execute_process(COMMAND ${CLI} solver-run code_aster ${D}/m.export RESULT_VARIABLE rc2 OUTPUT_VARIABLE out2)
if(rc2 EQUAL 0 OR NOT out2 MATCHES "ma thoat 3")
    message(FATAL_ERROR "loi cua solver phai duoc bao (rc=${rc2}):\n${out2}")
endif()
