execute_process(COMMAND ${CLI} result import ${IN} ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "import loi: ${out} ${err}")
endif()
execute_process(COMMAND ${CLI} result info ${OUT} RESULT_VARIABLE rc2 OUTPUT_VARIABLE info)
if(NOT rc2 EQUAL 0)
  message(FATAL_ERROR "info loi: ${info}")
endif()
# 2 tam giac -> 2 lang tru x 3 tu dien; 1 tu giac -> 1 hex x 6 tu dien = 12 tu dien; 10 nut (5 x 2 lop)
foreach(needle "Nut: 10" "Phan tu: 12" "Pressure" "Velocity")
  string(FIND "${info}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "thieu '${needle}' trong: ${info}")
  endif()
endforeach()
