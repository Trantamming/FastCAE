# Khoang kín nắp trượt giải bằng OpenFOAM (icoFoam) thật, đọc kết quả về FastCAE.
# Cần OpenFOAM: Linux (gói openfoam hoặc bản ESI/Foundation) hoặc WSL; FastCAE tự nạp etc/bashrc nếu tìm thấy.
# Đặt openfoam_bashrc = /đường/dẫn/etc/bashrc nếu OpenFOAM nằm chỗ khác.
#
# Kiểm chứng: Re = 100 -> u tại tâm khoang (x = y = 0.5) của Ghia et al. 1982 = -0.20581.
# Lưới 41 x 41 (số ô lẻ nên có ô chính giữa) cho -0.20584 trong lần thử với OpenFOAM v1912.
type = cavity
solver = openfoam
n = 41          # số ô mỗi cạnh
Re = 100
lid_speed = 1.0
end_time = 5    # giây mô phỏng (Re = 100 ổn định sau khoảng 2 giây)
work_dir = foam_run
